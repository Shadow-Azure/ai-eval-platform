{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-eval-platform.local/runner-contract/v1/task-manifest.schema.json",
  "title": "Eval shard task manifest",
  "description": "Versioned shard manifest fetched by the runner after dispatch. The platform owns the digest and the object keys; the runner must verify both before executing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "eval_run_id",
    "shard_id",
    "attempt",
    "dispatch_key",
    "callback_base_url",
    "deadline",
    "cases"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "eval_run_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "shard_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "attempt": { "type": "integer", "minimum": 1 },
    "dispatch_key": { "type": "string", "minLength": 1, "maxLength": 256 },
    "callback_base_url": { "type": "string", "format": "uri", "maxLength": 2048 },
    "deadline": { "type": "string", "format": "date-time" },
    "case_timeout_seconds": { "type": "integer", "minimum": 1 },
    "max_attempts": { "type": "integer", "minimum": 1 },
    "max_turns": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "runs_on": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._ -]+$" }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_run_id", "case_key"],
        "properties": {
          "case_run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "case_key": { "type": "string", "minLength": 1, "maxLength": 256 },
          "dataset_case_id": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    }
  }
}
