{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-eval-platform.local/runner-contract/v1/upload-manifest.schema.json",
  "title": "Upload manifest",
  "description": "Objects produced by an attempt. The platform-issued object keys are reported back before completion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_run_id", "attempt", "objects"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "case_run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "attempt": { "type": "integer", "minimum": 1 },
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_kind", "object_key", "sha256", "size", "content_type"],
        "properties": {
          "artifact_kind": { "enum": ["score", "trace", "artifact"] },
          "object_key": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 0 },
          "content_type": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    }
  }
}
