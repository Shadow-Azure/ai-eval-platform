{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-eval-platform.local/runner-contract/v1/failure.schema.json",
  "title": "Case attempt failure",
  "description": "Terminal or retryable failure callback for one case attempt. retryable decides whether the platform may create a new attempt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "case_run_id",
    "attempt",
    "sequence",
    "error_code",
    "retryable",
    "error_summary",
    "phase"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "case_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "error_code": {
      "enum": [
        "manifest_invalid",
        "manifest_digest_mismatch",
        "token_invalid",
        "attempt_mismatch",
        "dispatch_duplicate",
        "upload_failed",
        "image_unavailable",
        "callback_retryable",
        "callback_permanent",
        "runner_bootstrap_failed",
        "runtime_error",
        "runner_lost",
        "execution_timeout"
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "error_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "phase": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "description": "Structured terminal failure classified by the runner (429/quota/auth/timeout/crash/asset install). Optional so older runners stay compatible.",
      "required": ["code"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "phase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "http_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "trace_manifest": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "object_key",
            "sha256",
            "size"
          ],
          "properties": {
            "object_key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 0
            },
            "manifest_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16
            },
            "capture_status": {
              "enum": [
                "complete",
                "partial",
                "incomplete",
                "degraded",
                "failed"
              ]
            },
            "incomplete_reasons": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "runtime_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "format_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "adapter_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "objects"
          ],
          "properties": {
            "manifest_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16
            },
            "capture_status": {
              "enum": [
                "complete",
                "partial",
                "incomplete",
                "degraded",
                "failed"
              ]
            },
            "incomplete_reasons": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "runtime_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "format_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "adapter_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "objects": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "artifact_kind",
                  "logical_path",
                  "object_key",
                  "sha256",
                  "size",
                  "content_type"
                ],
                "properties": {
                  "artifact_kind": {
                    "enum": [
                      "trace",
                      "trace_metadata",
                      "trace_diagnostic"
                    ]
                  },
                  "logical_path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512,
                    "pattern": "^(?!.*[\\r\\n])(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
                  },
                  "object_key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "content_type": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "native_format": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "runtime_version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "format_version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                }
              }
            }
          }
        }
      ],
      "description": "Optional partial trace uploaded before a terminal failure (for example a job cancellation). The platform verifies every object and enqueues parsing before settling the attempt."
    }
  }
}
